{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Mint Starter Kit",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Spoty.dev",
          "icon": "cat",
          "color": {
            "light": "#FFC022",
            "dark": "#FFC022"
          },
          "href": "https://spoty.dev"
        },
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "https://mintlify.com/docs"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://mintlify.com/blog"
        }
      ]
    },
    "products": [
      {
        "product": "CuraLink",
        "color": {
          "light": "#FFC022",
          "dark": "#FFC022"
        },
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Getting started",
                "pages": [
                  "index",
                  "quickstart",
                  "development"
                ]
              },
              {
                "group": "Customization",
                "pages": [
                  "essentials/settings",
                  "essentials/navigation"
                ]
              },
              {
                "group": "Writing content",
                "pages": [
                  "essentials/markdown",
                  "essentials/code",
                  "essentials/images",
                  "essentials/reusable-snippets"
                ]
              },
              {
                "group": "AI tools",
                "pages": [
                  "ai-tools/cursor",
                  "ai-tools/claude-code",
                  "ai-tools/windsurf"
                ]
              }
            ]
          },
          {
            "tab": "API reference",
            "groups": [
              {
                "group": "API documentation",
                "pages": [
                  "api-reference/introduction"
                ]
              },
              {
                "group": "Endpoint examples",
                "pages": [
                  "api-reference/endpoint/get",
                  "api-reference/endpoint/create",
                  "api-reference/endpoint/delete",
                  "api-reference/endpoint/webhook"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hola@spoty.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/spoty.dev",
      "github": "https://github.com/spoty.dev",
      "linkedin": "https://linkedin.com/company/spoty.dev",
      "website": "https://spoty.dev"
    }
  },
  "fonts": {
    "source": "https://fonts.google.com/specimen/Montserrat",
    "family": "Montserrat",
    "weight": 400,
    "format": "woff",
    "heading": {
      "source": "https://fonts.google.com/specimen/Montserrat",
      "family": "Montserrat",
      "weight": 600,
      "format": "woff"
    },
    "body": {
      "source": "https://fonts.google.com/specimen/Montserrat",
      "family": "Montserrat",
      "weight": 400,
      "format": "woff"
    }
  },
  "thumbnails": {
    "fonts": {
      "family": "Montserrat"
    }
  },
  "search": {
    "prompt": "Miau..."
  },
  "integrations": {
    "cookies": {
      "key": "spoty",
      "value": "true"
    }
  }
}
